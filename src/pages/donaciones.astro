---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scribble from "../components/Scribble.astro";

const ways = [
  { text: "Aporte monetario para campañas y actividades.", dot: "bg-joaju-yellow" },
  { text: "Ropa, abrigo, alimentos o útiles escolares.", dot: "bg-joaju-orange" },
  { text: "Participación como voluntario en acciones solidarias.", dot: "bg-joaju-yellow" },
  { text: "Servicios, alianzas o apoyo en difusión.", dot: "bg-joaju-orange" }
];

const helpOptions = [
  { value: "Aporte monetario", label: "Aporte monetario" },
  { value: "Insumos", label: "Ropa o insumos" },
  { value: "Servicios o alianzas", label: "Servicios o alianzas" },
  { value: "Otros", label: "Otros" }
];
---

<BaseLayout title="Donaciones | Joaju" description="Contanos cómo te gustaría colaborar con Joaju: donaciones, voluntariado, servicios o alianzas.">
  <main class="relative overflow-clip py-14 md:py-20">
    <div class="pointer-events-none absolute -right-40 -top-48 h-[520px] w-[520px] rounded-full bg-joaju-sand" aria-hidden="true"></div>
    <section class="container-joaju relative grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
      <div data-animate="up">
        <a href="/" class="link-arrow"><span aria-hidden="true">←</span> Volver al inicio</a>
        <div class="mt-8">
          <span class="eyebrow">Donaciones</span>
        </div>
        <h1 class="mt-4 mb-0 text-[clamp(2.6rem,6vw,4.6rem)] font-extrabold leading-[0.98] tracking-[-0.02em] text-joaju-dark">
          ¿Querés apoyar a
          <span class="relative inline-block whitespace-nowrap">
            Joaju?
            <Scribble class="absolute -bottom-[0.06em] left-0 h-[0.2em] w-full text-joaju-orange" width={6} />
          </span>
        </h1>
        <p class="mt-7 mb-0 text-lg leading-8 text-joaju-muted">
          Completa este formulario para contarnos cómo te gustaría colaborar. Puedes donar, sumarte como
          voluntario o aportar desde tus recursos, tu tiempo o tus contactos.
        </p>

        <div class="mt-9 rounded-[2rem] bg-joaju-dark p-7 text-white shadow-soft">
          <h2 class="m-0 text-2xl font-extrabold text-joaju-yellow">Formas de ayudar</h2>
          <ul class="m-0 mt-5 grid list-none gap-4 p-0">
            {ways.map((way) => (
              <li class="flex gap-3.5 text-[1.05rem] font-semibold leading-7 text-white/90">
                <span class:list={["mt-2 h-3 w-3 shrink-0 rounded-full", way.dot]} aria-hidden="true"></span>
                <span>{way.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <form
        data-animate="scale"
        action="https://formsubmit.co/joajuvoluntario@gmail.com"
        method="post"
        class="h-fit rounded-[2rem] border border-joaju-dark/8 bg-joaju-paper p-6 shadow-soft md:p-9"
      >
        <input type="hidden" name="_subject" value="Nueva solicitud de ayuda desde Joaju" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://joaju-phi.vercel.app/?donacion=enviada" />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid gap-5 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="field-label">Nombre</span>
            <input type="text" name="nombre" required autocomplete="name" placeholder="Tu nombre" class="field" />
          </label>

          <label class="grid gap-2">
            <span class="field-label">Correo</span>
            <input type="email" name="email" required autocomplete="email" placeholder="tu@email.com" class="field" />
          </label>

          <label class="grid gap-2 md:col-span-2">
            <span class="field-label">Teléfono <span class="font-semibold normal-case tracking-normal text-joaju-muted">(opcional)</span></span>
            <input type="tel" name="telefono" autocomplete="tel" placeholder="Tu número de contacto" class="field" />
          </label>
        </div>

        <fieldset class="m-0 mt-7 border-0 p-0">
          <legend class="field-label p-0">¿Cómo te gustaría ayudar?</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {helpOptions.map((option) => (
              <label class="flex cursor-pointer items-center gap-3 rounded-2xl border-2 border-joaju-dark/12 bg-white px-4 py-3 font-bold text-joaju-dark transition hover:border-joaju-dark/40 has-[:checked]:border-joaju-dark has-[:checked]:bg-joaju-yellow has-[:focus-visible]:border-joaju-orange">
                <input type="checkbox" name="ayuda" value={option.value} class="h-5 w-5 accent-[#00282f]" />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="mt-7 grid gap-2">
          <span class="field-label">Mensaje <span class="font-semibold normal-case tracking-normal text-joaju-muted">(opcional)</span></span>
          <textarea name="mensaje" placeholder="Cuéntanos cómo te gustaría colaborar" class="field min-h-36"></textarea>
        </label>

        <button type="submit" class="btn btn-yellow mt-8 w-full sm:w-auto sm:min-w-[220px]">
          Enviar
        </button>
      </form>
    </section>
  </main>
</BaseLayout>
