---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Scribble from "../../components/Scribble.astro";
import { activitiesByYear, activityYears } from "../../data/activities";

const firstYear = activityYears[0];
const lastYear = activityYears[activityYears.length - 1];
const preview = 3;
---

<BaseLayout title="Actividades | Joaju">
  <main class="relative min-h-screen overflow-clip py-14 md:py-20">
    <div class="pointer-events-none absolute -right-40 -top-48 h-[520px] w-[520px] rounded-full bg-joaju-sand" aria-hidden="true"></div>
    <section class="container-joaju relative">
      <a href="/#actividades" class="link-arrow"><span aria-hidden="true">←</span> Volver al inicio</a>

      <div class="mt-8 max-w-3xl" data-animate="up">
        <span class="eyebrow">Actividades por año</span>
        <h1 class="mt-4 mb-0 text-[clamp(2.6rem,6vw,4.6rem)] font-extrabold leading-[0.98] tracking-[-0.02em] text-joaju-dark">
          Explora el recorrido de Joaju entre {firstYear} y
          <span class="relative inline-block whitespace-nowrap">
            {lastYear}
            <Scribble class="absolute -bottom-[0.06em] left-0 h-[0.2em] w-full text-joaju-orange" width={6} />
          </span>
        </h1>
        <p class="mt-6 mb-0 text-lg leading-8 text-joaju-muted">
          Cada año reúne actividades, campañas y experiencias solidarias. Entra a una etapa para ver su
          detalle y luego recorre cada actividad individual con descripción y galería.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {activitiesByYear.map(({ year, items }, index) => (
          <a
            href={`/actividades/${year}`}
            class="card group relative flex flex-col overflow-hidden p-7 transition duration-200 hover:-translate-y-1.5 hover:shadow-soft"
            data-animate="up"
            style={`transition-delay:${(index % 3) * 90}ms`}
          >
            <span class:list={["absolute inset-x-0 top-0 h-2", index % 2 === 0 ? "bg-joaju-yellow" : "bg-joaju-orange"]} aria-hidden="true"></span>
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="m-0 text-[3.4rem] font-extrabold leading-none text-joaju-dark">{year}</h2>
              <span class="rounded-full bg-joaju-cream px-3 py-1 text-sm font-extrabold text-joaju-dark">
                {items.length} {items.length === 1 ? "actividad" : "actividades"}
              </span>
            </div>
            <ul class="m-0 mt-6 mb-7 grid list-none gap-2.5 p-0 text-joaju-muted">
              {items.slice(0, preview).map((activity) => (
                <li class="flex gap-3 leading-6">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-joaju-orange" aria-hidden="true"></span>
                  <span>{activity.title}</span>
                </li>
              ))}
              {items.length > preview && (
                <li class="pl-5 text-sm font-bold text-joaju-dark/70">y {items.length - preview} más</li>
              )}
            </ul>
            <span class="link-arrow mt-auto">Ver año completo <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
