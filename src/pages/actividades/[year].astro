---
import BaseLayout from "../../layouts/BaseLayout.astro";
import YearTabs from "../../components/YearTabs.astro";
import { activityYears, getYearActivities } from "../../data/activities";

export function getStaticPaths() {
  return activityYears.map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      items: getYearActivities(year)
    }
  }));
}

const { year, items } = Astro.props;
---

<BaseLayout title={`Actividades ${year} | Joaju`}>
  <main class="relative min-h-screen overflow-clip py-14 md:py-20">
    <div class="pointer-events-none absolute -right-40 -top-48 h-[520px] w-[520px] rounded-full bg-joaju-sand" aria-hidden="true"></div>
    <section class="container-joaju relative">
      <a href="/actividades" class="link-arrow"><span aria-hidden="true">←</span> Volver a años</a>

      <div class="mt-8 max-w-3xl">
        <span class="eyebrow">Año {year}</span>
        <h1 class="mt-4 mb-0 text-[clamp(2.6rem,6vw,4.6rem)] font-extrabold leading-[0.98] tracking-[-0.02em] text-joaju-dark">
          Actividades realizadas en <span class="text-joaju-ember">{year}</span>
        </h1>
        <p class="mt-5 mb-0 text-lg leading-8 text-joaju-muted">
          Selecciona una actividad para ver su descripción completa.
        </p>
      </div>

      <div class="mt-8">
        <YearTabs current={year} />
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {items.map((activity, index) => (
          <a
            href={`/actividades/${year}/${activity.slug}`}
            class="card group flex flex-col overflow-hidden transition duration-200 hover:-translate-y-1.5 hover:shadow-soft"
            data-animate="up"
            style={`transition-delay:${(index % 2) * 90}ms`}
          >
            {activity.heroImage && (
              <div class="overflow-hidden">
                <img
                  src={activity.heroImage}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-7">
              <div class="flex flex-wrap items-center gap-2 text-sm font-extrabold">
                <span class:list={["rounded-full px-3 py-1 text-joaju-dark", index % 2 === 0 ? "bg-joaju-yellow" : "bg-joaju-orange"]}>
                  {activity.dateLabel}
                </span>
                <span class="rounded-full bg-joaju-cream px-3 py-1 text-joaju-muted">{activity.location}</span>
              </div>
              <h2 class="mt-5 mb-0 text-[1.7rem] font-extrabold leading-tight text-joaju-dark">{activity.title}</h2>
              <p class="mt-3 mb-6 leading-7 text-joaju-muted">{activity.summary}</p>
              <span class="link-arrow mt-auto">Ver actividad <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
