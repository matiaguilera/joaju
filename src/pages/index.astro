---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scribble from "../components/Scribble.astro";
import { activities, activitiesByYear } from "../data/activities";

const committee = [
  { name: "Ada Melgarejo", role: "Organizadora", image: "/miembros/ada.webp" },
  { name: "Angélica Vargas", role: "Presidenta", image: "/miembros/angelica.webp" },
  { name: "Carlos Armoa", role: "Organizador", image: "/miembros/carlos.webp" },
  { name: "Cindy Troche", role: "Organizadora", image: "/miembros/cindy.webp" },
  { name: "Daiana Ruiz", role: "Organizadora", image: "/miembros/daiana.webp" },
  { name: "Diego Maciel", role: "Organizador", image: "/miembros/diego-maciel.webp" },
  { name: "Fernando Baez", role: "Organizador", image: "/miembros/fernando.webp" },
  { name: "Gabriela González", role: "Organizadora", image: "/miembros/gabriela.webp" },
  { name: "Leticia Fernandez", role: "Redes Sociales y Marketing", image: "/miembros/leticia.webp" },
  { name: "Marcelo Villalba", role: "Secretario", image: "/miembros/marcelo.webp" },
  { name: "Maria Inés Benitez", role: "Organizadora", image: "/miembros/ines.webp" },
  { name: "Montserrat Moré", role: "Organizadora", image: "/miembros/montserrat.webp" },
  { name: "Sofia Torres", role: "Organizadora", image: "/miembros/sofia.webp" }
];

const isOrganizer = (role: string) => role.startsWith("Organizador");

const stats = [
  { value: "2018", label: "primeras acciones de voluntariado" },
  { value: "2021", label: "nace Joaju, con nombre e identidad propia" },
  { value: String(activities.length), label: "actividades realizadas desde 2022" },
  { value: String(committee.length), label: "voluntarios en el comité" }
];

const pillars = [
  {
    title: "Misión",
    description:
      "Generar oportunidades, acompañar procesos y crear espacios donde la solidaridad se vuelva una herramienta concreta para dibujar el futuro.",
    panel: "bg-joaju-yellow md:rounded-r-[1.25rem]",
    icon: "pencil"
  },
  {
    title: "Visión",
    description:
      "Ser una red de voluntariado referente en impacto comunitario, integrando compromiso humano, creatividad y trabajo colaborativo.",
    panel: "bg-joaju-orange md:rounded-l-[1.25rem]",
    icon: "sunrise"
  }
];

const history = [
  {
    label: "2018",
    text: "Hay historias que no se planifican, simplemente suceden. En 2018, una inquietud compartida dentro de Datapar dio origen a las primeras acciones de voluntariado. Sin un nombre todavía, pero con un propósito muy claro: impactar comunidades y abrazar vidas.",
    image: "/historia/historia-1.webp",
    alt: "Primeras acciones de voluntariado de Joaju",
    width: 512,
    height: 215
  },
  {
    label: "Finales de 2021",
    text: "A finales del 2021, esa inquietud se convirtió en identidad. Nació Joaju. Y con él, un espacio donde cada iniciativa, desde un desayuno hasta una charla de liderazgo, tenía el poder de transformar, tanto a quien lo recibía como a quien lo daba.",
    image: "/historia/historia-2.webp",
    alt: "Encuentro de voluntarios en los inicios de Joaju",
    width: 512,
    height: 384
  },
  {
    label: "Hoy",
    text: "Hoy, más de 1.000 personas llevan una parte de Joaju con ellas. Y nosotros seguimos adelante, construyendo una red de voluntariado referente, donde el compromiso humano, la creatividad y el trabajo colaborativo son la base de todo.",
    image: "/historia/historia-3.webp",
    alt: "Red de voluntariado Joaju en crecimiento",
    width: 512,
    height: 385
  }
];

const quotes = [
  {
    quote: "No subestimes lo que puedes dar. A veces lo que para ti es simple, puede ser extraordinario",
    name: "Fabricio Caon",
    role: "Precursor Joaju",
    image: "/frases/fabricio.webp",
    accent: "text-joaju-yellow"
  },
  {
    quote: "Cada acción que nace del corazón, deja huellas",
    name: "Paz Da Re",
    role: "Precursora Joaju",
    image: "/frases/paz.webp",
    accent: "text-joaju-orange"
  }
];

const announcements = [
  {
    title: "Banco de Sangre",
    description: "Una iniciativa orientada a promover la donación voluntaria y el compromiso solidario con la comunidad.",
    href: "/actividades/2026/banco-de-sangre",
    icon: "drop",
    tile: "bg-joaju-orange text-white"
  },
  {
    title: "Capacitación Primeros Auxilios",
    description: "Una actividad pensada para fortalecer conocimientos básicos y preparación ante situaciones de emergencia.",
    href: "/actividades/2026/capacitacion-primeros-auxilios",
    icon: "aid",
    tile: "bg-joaju-dark text-joaju-yellow"
  },
  {
    title: "Campaña Manos que abrigan",
    description: "Una campaña solidaria enfocada en acompañar a quienes más lo necesitan con abrigo y apoyo cercano.",
    href: "/actividades/2026/campana-manos-que-abrigan",
    icon: "heart",
    tile: "bg-joaju-yellow text-joaju-dark"
  }
];

const icons: Record<string, string[]> = {
  pencil: ["M4 20l1-4.2L16.4 4.4a2.1 2.1 0 0 1 3 3L8 18.8 4 20Z", "M14.4 6.6l3 3"],
  sunrise: ["M3 18h18", "M6.5 18a5.5 5.5 0 0 1 11 0", "M12 6v2.5", "M5 10.5l1.8 1.8", "M19 10.5l-1.8 1.8"],
  drop: ["M12 3.2S18 9.3 18 13.6a6 6 0 0 1-12 0C6 9.3 12 3.2 12 3.2Z", "M9.4 14.2a2.7 2.7 0 0 0 2.2 2.4"],
  aid: ["M5.5 7h13A2.5 2.5 0 0 1 21 9.5v8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.500v-8A2.5 2.5 0 0 1 5.5 7Z", "M9 7V5.500A1.5 1.5 0 0 1 10.500 4h3A1.5 1.5 0 0 1 15 5.500V7", "M12 10.500v6", "M9 13.500h6"],
  heart: ["M12 20.200S4.5 15.700 4.5 10.200A4.2 4.2 0 0 1 12 7.600a4.200 4.200 0 0 1 7.500 2.600C19.500 15.700 12 20.200 12 20.200Z"]
};
---

<BaseLayout title="Joaju - Dibujando el Futuro" home>
  <div
    id="donation-success"
    class="fixed left-1/2 top-24 z-50 hidden w-[min(92vw,520px)] -translate-x-1/2 rounded-3xl border-2 border-joaju-yellow bg-white px-5 py-4 text-joaju-dark shadow-soft"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="m-0 font-extrabold text-joaju-dark">Mensaje enviado correctamente</p>
        <p class="m-0 mt-1 text-sm leading-6 text-joaju-muted">Gracias por contactar con Joaju. Recibimos tu solicitud y te responderemos pronto.</p>
      </div>
      <button
        type="button"
        data-close-donation-success
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-joaju-dark/15 text-xl leading-none text-joaju-muted transition hover:bg-joaju-dark/5 hover:text-joaju-dark"
        aria-label="Cerrar mensaje"
      >
        ×
      </button>
    </div>
  </div>

  <main>
    <!-- Portada -->
    <section id="inicio" class="relative overflow-clip">
      <div class="pointer-events-none absolute -right-40 -top-48 h-[420px] w-[420px] rounded-full bg-joaju-sand md:h-[640px] md:w-[640px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-28 h-56 w-56 rounded-full border-[28px] border-joaju-yellow/25" aria-hidden="true"></div>

      <div class="container-joaju relative grid items-center gap-12 py-14 md:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
        <div data-animate="up">
          <span class="inline-flex items-center gap-2 rounded-full bg-joaju-dark px-4 py-2 text-[0.78rem] font-extrabold uppercase tracking-[0.16em] text-joaju-yellow">
            <span class="h-2 w-2 rounded-full bg-joaju-orange" aria-hidden="true"></span>
            Voluntariado Datapar
          </span>
          <h1 class="mt-6 mb-0 text-[clamp(3.2rem,9vw,6.4rem)] font-extrabold leading-[0.92] tracking-[-0.02em] text-joaju-dark">
            <span class="sr-only">Joaju: </span>Dibujando el
            <span class="relative inline-block whitespace-nowrap">
              futuro
              <Scribble class="absolute -bottom-[0.06em] left-0 h-[0.2em] w-full text-joaju-orange" width={7} />
            </span>
          </h1>
          <p class="mt-8 max-w-[34rem] text-xl leading-8 text-joaju-muted">
            Una comunidad que transforma el compromiso humano en acciones concretas para abrazar vidas y abrir oportunidades.
          </p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a class="btn btn-yellow min-w-[200px]" href="#voluntariado">Sumar mi ayuda</a>
            <a class="btn btn-outline min-w-[180px]" href="#quienes-somos">Conocer Joaju</a>
          </div>
        </div>

        <!-- Dos figuras que se abrazan, como en el logo: un círculo y un cuerpo en "U" -->
        <div class="relative mx-auto aspect-[10/11] w-full max-w-[340px] sm:max-w-[420px] lg:max-w-[500px]" data-animate="scale">
          <span class="absolute left-[20%] top-0 aspect-square w-[14%] rounded-full bg-joaju-yellow" aria-hidden="true"></span>
          <div class="hug-frame absolute left-0 top-[17%] w-[54%] bg-joaju-yellow p-[2.2%] shadow-soft">
            <img src="/historia/historia-3.webp" alt="Voluntarios de Joaju con sus certificados" width="512" height="385" fetchpriority="high" decoding="async" class="hug-frame aspect-[4/5] w-full object-cover" />
          </div>

          <span class="absolute right-[20%] top-[12%] aspect-square w-[14%] rounded-full bg-joaju-orange" aria-hidden="true"></span>
          <div class="hug-frame absolute right-0 top-[29%] z-10 w-[54%] bg-joaju-orange p-[2.2%] shadow-soft">
            <img src="/historia/historia-4.webp" alt="Voluntarios de Joaju junto a niñas y niños en una actividad" width="512" height="385" fetchpriority="high" decoding="async" class="hug-frame aspect-[4/5] w-full object-cover" />
          </div>

          <div class="float-slow absolute -left-2 bottom-[2%] z-20 w-[52%] max-w-[230px] -rotate-3 rounded-3xl bg-joaju-dark p-4 text-white shadow-soft sm:p-5">
            <span class="font-display text-3xl font-extrabold leading-none text-joaju-yellow sm:text-4xl">+1.000</span>
            <p class="m-0 mt-1 text-sm font-bold leading-5 text-white/85">personas llevan una parte de Joaju con ellas</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cifras -->
    <section class="bg-joaju-dark text-white" aria-label="Joaju en cifras">
      <dl class="container-joaju my-0 grid grid-cols-2 gap-x-6 gap-y-8 py-10 md:grid-cols-4 md:py-12">
        {stats.map((stat, index) => (
          <div class="flex flex-col-reverse" data-animate="up" style={`transition-delay:${index * 90}ms`}>
            <dt class="mt-1 max-w-[13rem] text-[0.95rem] font-semibold leading-6 text-white/75">{stat.label}</dt>
            <dd class:list={["m-0 font-display text-[clamp(2.4rem,5vw,3.4rem)] font-extrabold leading-none", index % 2 === 0 ? "text-joaju-yellow" : "text-joaju-orange"]}>
              {stat.value}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Quiénes somos -->
    <section id="quienes-somos" class="py-20 md:py-28">
      <div class="container-joaju grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="relative mx-auto w-full max-w-[520px]" data-animate="scale">
          <div class="absolute inset-0 translate-x-4 translate-y-4 rotate-2 rounded-[2rem] bg-joaju-yellow" aria-hidden="true"></div>
          <img src="/historia/historia-2.webp" alt="Ronda de voluntarios de Joaju compartiendo con la comunidad" width="512" height="384" loading="lazy" decoding="async" class="relative aspect-[4/3] w-full rounded-[2rem] object-cover shadow-soft" />
          <span class="absolute -right-3 -top-5 h-14 w-14 rounded-full bg-joaju-orange" aria-hidden="true"></span>
        </div>

        <div data-animate="up">
          <span class="eyebrow">¿Quiénes somos?</span>
          <h2 class="heading-section">
            Una comunidad unida por el
            <span class="relative inline-block whitespace-nowrap">
              calor humano
              <Scribble class="absolute -bottom-[0.08em] left-0 h-[0.22em] w-full text-joaju-yellow" width={6} />
            </span>
            y la esperanza
          </h2>
          <p class="mt-7 text-lg leading-8 text-joaju-muted">
            Somos Joaju, un programa de voluntariado compuesto por los colaboradores de Datapar.
            Nacimos con la misión de realizar acciones solidarias, buscando aportar en la construcción
            de mejores oportunidades para niños, adolescentes, jóvenes y adultos en situación vulnerable.
          </p>
        </div>
      </div>
    </section>

    <!-- Misión y visión -->
    <section id="mision-vision" class="bg-joaju-paper py-20 md:py-28">
      <div class="container-joaju">
        <div class="max-w-2xl" data-animate="up">
          <span class="eyebrow">Nuestra esencia</span>
          <h2 class="heading-section">Misión y visión</h2>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-2">
          {pillars.map((pillar, index) => (
            <article class:list={["relative overflow-hidden rounded-[2.5rem] p-8 text-joaju-dark md:p-11", pillar.panel]} data-animate="up" style={`transition-delay:${index * 140}ms`}>
              <span class="pointer-events-none absolute -right-14 -top-14 h-48 w-48 rounded-full border-[22px] border-white/25" aria-hidden="true"></span>
              <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-joaju-dark text-white">
                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {icons[pillar.icon].map((d) => <path d={d} />)}
                </svg>
              </span>
              <h3 class="mt-7 mb-0 text-[clamp(2.2rem,4vw,3rem)] font-extrabold leading-none">{pillar.title}</h3>
              <p class="mt-4 mb-0 max-w-[30rem] text-lg font-semibold leading-8">{pillar.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Nuestra historia -->
    <section id="historia" class="py-20 md:py-28">
      <div class="container-joaju">
        <div class="mx-auto max-w-3xl text-center" data-animate="up">
          <span class="eyebrow">Nuestra historia</span>
          <h2 class="heading-section">Un recorrido construido con solidaridad y compromiso</h2>
        </div>

        <div class="relative mt-16">
          <div class="absolute bottom-3 left-[11px] top-3 border-l-[3px] border-dashed border-joaju-dark/20 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></div>
          <ol class="m-0 grid list-none gap-14 p-0 lg:gap-20">
            {history.map((item, index) => (
              <li class="relative grid items-center gap-6 pl-11 lg:grid-cols-2 lg:gap-24 lg:pl-0" data-animate="up">
                <span
                  class:list={[
                    "absolute left-0 top-2 h-[25px] w-[25px] rounded-full border-[5px] border-joaju-cream lg:left-1/2 lg:top-1/2 lg:-translate-x-1/2 lg:-translate-y-1/2",
                    index % 2 === 0 ? "bg-joaju-yellow" : "bg-joaju-orange"
                  ]}
                  aria-hidden="true"
                ></span>
                <div class:list={[index % 2 === 0 ? "lg:text-right" : "lg:order-2"]}>
                  <h3 class="m-0 text-[clamp(2.4rem,5vw,3.6rem)] font-extrabold leading-none text-joaju-ember">{item.label}</h3>
                  <p class="mt-4 mb-0 text-lg leading-8 text-joaju-muted">{item.text}</p>
                </div>
                <div class:list={["rounded-[1.75rem] bg-white p-2.5 shadow-soft", index % 2 === 0 ? "rotate-1" : "-rotate-1"]}>
                  <img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" class="h-auto w-full rounded-[1.25rem] object-cover" />
                </div>
              </li>
            ))}
          </ol>
        </div>

        <p class="mx-auto mt-20 mb-0 max-w-3xl text-center font-display text-[clamp(1.8rem,4vw,2.8rem)] font-extrabold leading-tight text-joaju-dark" data-animate="up">
          Este es solo el comienzo de una historia que se escribe
          <span class="relative inline-block whitespace-nowrap">
            entre todos.
            <Scribble class="absolute -bottom-[0.1em] left-0 h-[0.24em] w-full text-joaju-orange" width={6} />
          </span>
        </p>
      </div>
    </section>

    <!-- Frases -->
    <section class="bg-joaju-dark py-20 text-white md:py-24" aria-label="Frases de los precursores de Joaju">
      <div class="container-joaju grid gap-6 md:grid-cols-2">
        {quotes.map((item, index) => (
          <figure class="m-0 flex flex-col rounded-[2rem] border border-white/10 bg-white/5 p-8 md:p-10" data-animate="up" style={`transition-delay:${index * 120}ms`}>
            <span class:list={["font-display text-[6rem] font-extrabold leading-[0.6]", item.accent]} aria-hidden="true">“</span>
            <blockquote class="m-0 font-display text-[clamp(1.5rem,2.6vw,2rem)] font-bold leading-snug text-white">
              {item.quote}
            </blockquote>
            <figcaption class="mt-auto flex items-center gap-4 pt-8">
              <img src={item.image} alt="" width="440" height="440" loading="lazy" decoding="async" class="h-16 w-16 rounded-full border-[3px] border-white/20 object-cover" />
              <span>
                <span class="block text-lg font-extrabold text-white">{item.name}</span>
                <span class:list={["block text-sm font-bold", item.accent]}>{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Actividades -->
    <section id="actividades" class="py-20 md:py-28">
      <div class="container-joaju">
        <div class="flex flex-wrap items-end justify-between gap-6" data-animate="up">
          <div class="max-w-2xl">
            <span class="eyebrow">Actividades</span>
            <h2 class="heading-section">Nuestro recorrido, año por año</h2>
            <p class="mt-4 mb-0 text-lg leading-8 text-joaju-muted">
              Elige un año para explorar las actividades realizadas y entrar luego al detalle completo de cada una.
            </p>
          </div>
          <a href="/actividades" class="link-arrow">Ver todas las actividades <span aria-hidden="true">→</span></a>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-5">
          {activitiesByYear.map(({ year, items }, index) => (
            <a
              href={`/actividades/${year}`}
              class="card group relative flex flex-col overflow-hidden p-5 transition duration-200 last:col-span-2 hover:-translate-y-1.5 hover:shadow-soft md:p-6 md:last:col-span-1"
              data-animate="up"
              style={`transition-delay:${index * 80}ms`}
            >
              <span class:list={["absolute inset-x-0 top-0 h-2", index % 2 === 0 ? "bg-joaju-yellow" : "bg-joaju-orange"]} aria-hidden="true"></span>
              <span class="mt-2 font-display text-[clamp(2.6rem,5vw,3.4rem)] font-extrabold leading-none text-joaju-dark">{year}</span>
              <span class="mt-2 font-bold text-joaju-muted">
                {items.length} {items.length === 1 ? "actividad" : "actividades"}
              </span>
              <span class="mt-6 inline-flex h-10 w-10 items-center justify-center rounded-full bg-joaju-dark text-lg text-white transition duration-200 group-hover:translate-x-1 group-hover:bg-joaju-orange" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Anuncios -->
    <section id="anuncios" class="bg-joaju-paper py-20 md:py-28">
      <div class="container-joaju">
        <div class="max-w-2xl" data-animate="up">
          <span class="eyebrow">Lo que viene</span>
          <h2 class="heading-section">Anuncios y próximos eventos</h2>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {announcements.map((item, index) => (
            <a href={item.href} class="group flex flex-col rounded-[2rem] border border-joaju-dark/8 bg-joaju-cream p-7 transition duration-200 hover:-translate-y-1.5 hover:shadow-soft" data-animate="up" style={`transition-delay:${index * 120}ms`}>
              <span class:list={["inline-flex h-[72px] w-[72px] items-center justify-center rounded-[1.4rem] transition duration-200 group-hover:-rotate-6", item.tile]}>
                <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {icons[item.icon].map((d) => <path d={d} />)}
                </svg>
              </span>
              <h3 class="mt-6 mb-0 text-[1.6rem] font-extrabold leading-tight text-joaju-dark">{item.title}</h3>
              <p class="mt-3 mb-6 leading-7 text-joaju-muted">{item.description}</p>
              <span class="link-arrow mt-auto">Ver detalle <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Equipo -->
    <section id="equipo" class="py-20 md:py-28">
      <div class="container-joaju">
        <div class="mx-auto max-w-2xl text-center" data-animate="up">
          <span class="eyebrow">Equipo</span>
          <h2 class="heading-section">Nuestros miembros</h2>
        </div>
        <ul class="m-0 mt-14 flex list-none flex-wrap justify-center gap-y-11 p-0">
          {committee.map((person, index) => (
            <li class="group w-1/2 px-2.5 text-center sm:w-1/3 lg:w-1/4" data-animate="up" style={`transition-delay:${(index % 4) * 80}ms`}>
              <div class:list={["mx-auto h-[124px] w-[124px] rounded-full p-[5px] transition duration-300 group-hover:-translate-y-1 group-hover:rotate-3 md:h-[148px] md:w-[148px]", index % 2 === 0 ? "bg-joaju-yellow" : "bg-joaju-orange"]}>
                <img src={person.image} alt="" width="264" height="264" loading="lazy" decoding="async" class="h-full w-full rounded-full border-4 border-joaju-cream object-cover" />
              </div>
              <h3 class="mt-4 mb-0 text-[1.3rem] font-bold leading-tight text-joaju-dark">{person.name}</h3>
              <p class:list={["mx-auto mt-2 mb-0 w-fit text-sm font-bold", isOrganizer(person.role) ? "text-joaju-muted" : "rounded-full bg-joaju-dark px-3 py-1 text-joaju-yellow"]}>
                {person.role}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Identidad visual -->
    <section id="identidad-visual" class="bg-joaju-paper py-20 md:py-28">
      <div class="container-joaju grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div data-animate="up">
          <span class="eyebrow">Identidad visual</span>
          <h2 class="heading-section">Un abrazo y una sonrisa</h2>
          <p class="mt-6 text-xl font-bold leading-8 text-joaju-dark">
            El concepto del logo e identidad visual es simbolizar el voluntariado como puente entre la ayuda y la necesidad.
          </p>
          <p class="mt-4 mb-0 text-lg leading-8 text-joaju-muted">
            La identidad de Joaju tiene varios significados. El logotipo tiene la forma de dos personas abrazándose,
            que le da un significado humano, cálido y de unidad, y la forma de una sonrisa, un gesto de alegría y felicidad.
          </p>
        </div>

        <div data-animate="scale">
          <figure class="m-0 rounded-[2rem] border border-joaju-dark/8 bg-white p-5 shadow-card md:p-7">
            <img src="/imagen-identidad-visual.webp" alt="Dos personas abrazándose más una sonrisa dan como resultado el isotipo de Joaju" width="1152" height="440" loading="lazy" decoding="async" class="h-auto w-full" />
            <figcaption class="grid grid-cols-3 text-center font-display text-lg font-bold text-joaju-dark md:text-xl">
              <span>Abrazo</span>
              <span>Sonrisa</span>
              <span class="text-joaju-ember">Joaju</span>
            </figcaption>
          </figure>
          <div class="mt-5 flex flex-wrap items-center gap-5 rounded-[2rem] bg-joaju-cream p-5 md:p-6">
            <div class="flex shrink-0 -space-x-5" aria-hidden="true">
              <span class="h-16 w-16 rounded-full border-4 border-joaju-cream bg-joaju-yellow"></span>
              <span class="h-16 w-16 rounded-full border-4 border-joaju-cream bg-joaju-orange"></span>
            </div>
            <p class="m-0 min-w-[14rem] flex-1 font-semibold leading-7 text-joaju-dark">
              Utilizamos colores cálidos y contrastados que refuerzan la idea de unión y alegría que quiere transmitir el proyecto.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sumate -->
    <section id="voluntariado" class="relative overflow-clip bg-joaju-yellow py-20 text-joaju-dark md:py-28">
      <span class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full border-[30px] border-white/25" aria-hidden="true"></span>
      <div class="container-joaju relative grid items-center gap-12 md:grid-cols-[1.25fr_0.75fr]">
        <div data-animate="up">
          <span class="eyebrow eyebrow-on-yellow">Sumate a Joaju</span>
          <h2 class="mt-4 mb-0 text-[clamp(3rem,7vw,5.4rem)] font-extrabold leading-[0.95] tracking-[-0.02em]">¡Sé parte de Joaju!</h2>
          <div class="mt-6 max-w-[38rem] space-y-3 text-lg font-semibold leading-8">
            <p class="m-0">El programa cuenta con la ayuda de colaboradores, amigos, familiares y clientes de Datapar.</p>
            <p class="m-0">Cualquiera con un corazón solidario es bienvenido.</p>
          </div>
          <p class="mt-6 mb-0 font-display text-[clamp(1.5rem,3vw,2rem)] font-extrabold leading-tight">
            ¿Te animás a transformar tu vida y la de los demás?<br />
            ¡Este es tu momento!
          </p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a class="btn btn-dark min-w-[200px]" href="/donaciones">Quiero ayudar</a>
            <a class="btn btn-outline min-w-[200px]" href="https://instagram.com/joajupy" target="_blank" rel="noopener noreferrer">Síguenos en Instagram</a>
          </div>
        </div>

        <!-- Una sonrisa que se dibuja -->
        <div class="mx-auto w-[min(300px,70%)] md:w-full md:max-w-[340px]" data-animate="scale" aria-hidden="true">
          <svg class="scribble scribble-uniform h-auto w-full" viewBox="0 0 220 200">
            <circle cx="62" cy="38" r="22" fill="#fffdf8" />
            <circle cx="158" cy="38" r="22" fill="#f85f14" />
            <path pathLength="1" stroke-width="24" class="text-joaju-dark" d="M28 92 C 34 196, 186 196, 192 92" />
          </svg>
        </div>
      </div>
    </section>
  </main>

  <script>
    const donationSuccess = document.querySelector<HTMLElement>("#donation-success");

    if (new URLSearchParams(window.location.search).get("donacion") === "enviada") {
      donationSuccess?.classList.remove("hidden");
      window.history.replaceState({}, "", window.location.pathname + window.location.hash);
    }

    donationSuccess?.querySelector<HTMLButtonElement>("[data-close-donation-success]")?.addEventListener("click", () => {
      donationSuccess.classList.add("hidden");
    });
  </script>
</BaseLayout>
