---
import { navItems, navCta, navHref } from "../data/nav";

const { home = false } = Astro.props;
const links = [...navItems, navCta];
const socialClass =
  "inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/80 transition hover:-translate-y-0.5 hover:border-joaju-yellow hover:text-joaju-yellow";
---

<footer class="bg-joaju-dark text-white">
  <div class="container-joaju grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1.1fr]">
    <div>
      <a href={home ? "#inicio" : "/"} class="inline-flex" aria-label="Joaju, ir al inicio">
        <img src="/joaju_light.webp" alt="Joaju - Dibujando el futuro" width="520" height="176" loading="lazy" decoding="async" class="h-14 w-auto" />
      </a>
      <p class="mt-5 max-w-xs leading-7 text-white/70">
        Programa de voluntariado de los colaboradores de Datapar. Una comunidad unida por el calor humano y la esperanza.
      </p>
      <div class="mt-6 flex items-center gap-3">
        <a href="https://instagram.com/joajupy" target="_blank" rel="noopener noreferrer" class={socialClass} aria-label="Instagram de Joaju">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.7 2.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 7.25A4.75 4.75 0 1 1 12 16.75 4.75 4.75 0 0 1 12 7.25Zm0 2A2.75 2.75 0 1 0 12 14.75 2.75 2.75 0 0 0 12 9.25Z" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/joaju/" target="_blank" rel="noopener noreferrer" class={socialClass} aria-label="LinkedIn de Joaju">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.95v5.66H9.34V8.98h3.41v1.57h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47Z" />
          </svg>
        </a>
        <a href="https://github.com/matiaguilera/joaju" target="_blank" rel="noopener noreferrer" class={socialClass} aria-label="Repositorio de Joaju en GitHub">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.93.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.37 9.37 0 0 1 12 6.98c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.51-.01 2.85 0 .27.18.59.69.49A10.23 10.23 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z" />
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h2 class="font-sans text-sm font-extrabold uppercase tracking-[0.18em] text-joaju-yellow">Navegación</h2>
      <div class="mt-4 grid gap-3 text-white/75">
        {links.map((item) => (
          <a href={navHref(item.href, home)} class="w-fit transition hover:text-white">{item.label}</a>
        ))}
        <a href="/donaciones" class="w-fit transition hover:text-white">Donaciones</a>
      </div>
    </div>

    <div>
      <h2 class="font-sans text-sm font-extrabold uppercase tracking-[0.18em] text-joaju-yellow">Contacto</h2>
      <div class="mt-4 grid gap-3 text-white/75">
        <a href="mailto:joajuvoluntario@gmail.com" class="w-fit break-all transition hover:text-white">joajuvoluntario@gmail.com</a>
        <a href="tel:+595986303376" class="w-fit transition hover:text-white">+595 986 303 376</a>
        <span>Ciudad del Este | Asunción, Paraguay</span>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-joaju py-5 text-sm text-white/55">Voluntariado Datapar</div>
  </div>
</footer>
