---
import { navItems, navCta, navHref } from "../data/nav";

const { home = false } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-joaju-dark/8 bg-joaju-cream/85 backdrop-blur-xl">
  <div class="container-joaju flex items-center justify-between gap-4 py-2.5">
    <a href={home ? "#inicio" : "/"} class="inline-flex items-center" aria-label="Joaju, ir al inicio">
      <img src="/logo.png" alt="Joaju - Dibujando el futuro" width="232" height="92" fetchpriority="high" decoding="async" class="h-[46px] w-auto object-contain md:h-[52px]" />
    </a>

    <nav class="hidden items-center gap-8 text-[0.98rem] font-bold text-joaju-dark/80 md:flex" aria-label="Principal">
      {navItems.map((item) => (
        <a
          href={navHref(item.href, home)}
          class="relative py-1 transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] after:origin-left after:scale-x-0 after:rounded-full after:bg-joaju-orange after:transition-transform after:duration-200 hover:text-joaju-dark hover:after:scale-x-100"
        >
          {item.label}
        </a>
      ))}
      <a href={navHref(navCta.href, home)} class="btn btn-yellow min-h-0 px-5 py-2.5 text-[0.95rem]">
        {navCta.label}
      </a>
    </nav>

    <details data-mobile-menu class="relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border-2 border-joaju-dark/15 bg-white text-joaju-dark marker:content-none [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Abrir menú</span>
        <span class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
        </span>
      </summary>
      <nav class="absolute right-0 top-[calc(100%+0.75rem)] grid min-w-[240px] gap-1 rounded-3xl border border-joaju-dark/10 bg-white p-3 shadow-soft" aria-label="Principal móvil">
        {navItems.map((item) => (
          <a href={navHref(item.href, home)} class="rounded-2xl px-4 py-3 font-bold text-joaju-dark transition hover:bg-joaju-cream">
            {item.label}
          </a>
        ))}
        <a href={navHref(navCta.href, home)} class="btn btn-yellow mt-1">
          {navCta.label}
        </a>
      </nav>
    </details>
  </div>
</header>
